# Copy to infra/.env and adjust. docker-compose.yml reads variables from
# infra/.env automatically because it sits next to the compose file.

POSTGRES_DB=smart_triage
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_password
POSTGRES_AI_RO_PASSWORD=ai_engine_ro_password

SECRET_KEY=change-me-to-a-real-random-value
DEBUG=true
SHADOW_MODE=true

# AES-GCM key for pii_quarantine.ciphertext — 32 raw bytes, base64-encoded.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=Zm9yLWRldi1vbmx5LTMyLWJ5dGUta2V5LWhlcmUhISE=
# Hard TTL on encrypted raw PII; the hourly beat task deletes past this.
PII_QUARANTINE_TTL_HOURS=72

# Ceiling for any single model call (NER, embeddings, inference), seconds.
# ai-engine uses it for its vLLM calls; core-api uses it as the read timeout
# on the NER and embedding calls it makes to ai-engine.
# A cold model load alone can take 15-20s, so a short value reports
# "provider down" for what is really "provider still warming up" — that was
# the cause of every ticket landing in MASK_FAILED. If you raise this past
# 120, also raise budget.max_latency_sec in thresholds.yaml and the
# gunicorn --timeout in services/core-api/docker-entrypoint.sh, or one of
# those will cut the call short first.
MODEL_TIMEOUT_SEC=120

# Connect budget for every call to a model server (ai-engine) or to
# ai-engine (core-api), kept SHORT and separate from the read budget above.
# Failing to open a TCP connection means the provider is unreachable (down,
# wrong host, firewall dropping the Docker subnet) — no amount of waiting
# fixes that. Only a reachable-but-busy provider deserves the long read
# window. Collapsing the two is what made a blocked route hang the submit
# form for the full 120s instead of erroring in 3.
MODEL_CONNECT_TIMEOUT_SEC=3

# --- OpenAI (optional) ------------------------------------------------------
#
# Used when CHAT_CLIENT_PROVIDER=openai. CLOUD_API_KEY and CLOUD_MODEL (an
# OpenAI model name) are then required — either missing fails the boot.
# CLOUD_BASE_URL is an optional proxy. A failing call degrades the ticket to
# HITL; there is no fallback to another provider.
# CLOUD_API_KEY=
# CLOUD_BASE_URL=
# CLOUD_MODEL=

# Ceiling on a single cloud generation. A triage proposal is a small JSON
# object, so this sits well clear of a legitimate reply — it is here to stop a
# runaway generation from running until the read timeout.
CLOUD_MAX_OUTPUT_TOKENS=4096

# "vllm" for real embeddings from the self-hosted vLLM server below, or "stub"
# for the deterministic offline embedder used in CI / no-GPU environments.
# Read by ai-engine only: core-api embeds tickets, KB and few-shot examples
# through ai-engine's /v1/embed (ADR-0012), so every vector comes from here.
# ⚠️ The KB vectors in pgvector must come from the same model on the same
# runtime: re-embed the KB through vLLM, or retrieval degrades silently.
EMBEDDING_PROVIDER=vllm

# ── Self-hosted vLLM (ADR-0009) ──────────────────────────────────────────
# Every model in the system by default: ai-engine's LLM, embeddings and
# reranking (RERANKER_PROVIDER=vllm), and the PII detection and embeddings
# core-api asks ai-engine for. Only ai-engine talks to vLLM (ADR-0012), so
# every setting below is ai-engine's. Run `docker compose --profile vllm up -d`.
#
# Tier-2 PII NER during masking runs on CHAT_MODEL, on the self-hosted chat
# server. On failure/timeout the ticket is flagged MASK_FAILED and sent to a
# human — never treated as "no PII".
#
# CHAT_CLIENT_PROVIDER picks where ai-engine's triage chat runs: "vllm"
# (default, CHAT_MODEL / CHAT_BASE_URL) or "openai" (the CLOUD_* settings
# above). Embeddings, reranking and PII NER always run on vLLM — raw ticket
# text never goes to the cloud. An unknown provider fails the boot.
CHAT_CLIENT_PROVIDER=vllm
CHAT_MODEL=Qwen/Qwen3-8B-AWQ
EMBED_MODEL=BAAI/bge-m3
# Base URLs default to the compose services (http://vllm-chat:8000/v1, ...).
# Set them to reach vLLM running elsewhere, e.g. http://host.docker.internal:8100/v1.
# CHAT_BASE_URL=
# EMBED_BASE_URL=
# RERANK_BASE_URL=
# vLLM reserves GPU memory up front, per server; the three fractions share one
# card. Tune to your VRAM.
# VLLM_CHAT_GPU_UTIL=0.6
# VLLM_EMBED_GPU_UTIL=0.1
# VLLM_RERANK_GPU_UTIL=0.1
# VLLM_CHAT_MAX_MODEL_LEN=8192
# VLLM_IMAGE_TAG=latest
# HF_CACHE_DIR=./.hf-cache
# "vllm" (default) serves the bge-reranker-v2-m3 cross-encoder spec §6.3 assumes,
# from vllm-rerank. "lexical" scores |query ∩ passage| / |query| —
# deterministic, fast, no model, for CI.
#
# ⚠️ They are separate calibrations. retrieval.floor = 0.45 is a CROSS-ENCODER
# score (ADR-0005), so under `lexical` it is compared against a token-overlap
# ratio — a different question, answered silently. See docs/TODO.md item 4.
RERANKER_PROVIDER=vllm

# The checkpoint vllm-rerank loads. Pin RERANKER_REVISION to a commit sha rather
# than leaving it at "main": a new upstream commit silently changes the score
# distribution the floor is compared against.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=main

NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── Advanced ─────────────────────────────────────────────────────────────
# These have working defaults in docker-compose.yml and rarely need setting
# by hand; they are listed so the full configuration surface is discoverable.
#
# ALLOWED_HOSTS=*                              # Django allowed hosts (compose sets "*")
# CORS_ALLOWED_ORIGINS=http://localhost:3000   # where the web frontend is served from
# AI_ENGINE_URL=http://ai-engine:8001          # core-api -> ai-engine (every model call)
# AI_ENGINE_ANALYZE_GRACE_SEC=5                # slack past budget.max_latency_sec on /v1/analyze
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# THRESHOLDS_PATH=/workspace/services/core-api/config/thresholds.yaml
# LOG_LEVEL=INFO
