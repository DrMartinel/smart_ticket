# Copy to infra/.env and adjust. docker-compose.yml reads variables from
# infra/.env automatically because it sits next to the compose file.

POSTGRES_DB=smart_triage
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_password
POSTGRES_AI_RO_PASSWORD=ai_engine_ro_password

SECRET_KEY=change-me-to-a-real-random-value
DEBUG=true
SHADOW_MODE=true

# AES-GCM key for pii_quarantine.ciphertext — 32 raw bytes, base64-encoded.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=Zm9yLWRldi1vbmx5LTMyLWJ5dGUta2V5LWhlcmUhISE=
# Hard TTL on encrypted raw PII; the hourly beat task deletes past this.
PII_QUARANTINE_TTL_HOURS=72

# Seed 5 demo users + 12 KB articles on container start. Off by default so
# a real deployment never silently gains accounts with a known password.
# Run `manage.py seed_demo` manually instead when you want it on demand.
DJANGO_AUTO_SEED_DEMO=false

# Where the services reach Ollama. Two options — see
# docs/runbooks/on-call.md if containers time out here:
#   http://host.docker.internal:11434  — Ollama on the host. Requires the
#     host firewall to permit the Docker bridge subnet, or containers hang
#     on connect while `curl localhost:11434` works fine on the host.
#   http://ollama:11434  — Ollama as a compose service (no sudo needed):
#     docker compose --profile local-llm up -d
#     It bind-mounts OLLAMA_MODELS_DIR read-only, so nothing re-downloads.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Host model store re-used by the containerized Ollama (profile local-llm).
# systemd install: /usr/share/ollama/.ollama/models — user install: ~/.ollama/models
OLLAMA_MODELS_DIR=/usr/share/ollama/.ollama/models
OLLAMA_INFER_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=bge-m3
# Tier-2 PII NER during masking (core-api). On failure/timeout the ticket
# is flagged MASK_FAILED and sent to a human — never treated as "no PII".
OLLAMA_NER_MODEL=qwen3:8b

# Ceiling for any single model call (NER, embeddings, inference), seconds.
# A cold Ollama model load alone can take 15-20s, so a short value reports
# "provider down" for what is really "provider still warming up" — that was
# the cause of every ticket landing in MASK_FAILED. If you raise this past
# 120, also raise budget.max_latency_sec in thresholds.yaml and the
# gunicorn --timeout in services/core-api/docker-entrypoint.sh, or one of
# those will cut the call short first.
OLLAMA_TIMEOUT_SEC=120
MODEL_TIMEOUT_SEC=120

# Connect budget, kept SHORT and separate from the read budget above.
# Failing to open a TCP connection means the provider is unreachable (down,
# wrong host, firewall dropping the Docker subnet) — no amount of waiting
# fixes that. Only a reachable-but-busy provider deserves the long read
# window. Collapsing the two is what made a blocked route hang the submit
# form for the full 120s instead of erroring in 3.
OLLAMA_CONNECT_TIMEOUT_SEC=3
MODEL_CONNECT_TIMEOUT_SEC=3

# --- Cloud LLM primary (optional) -------------------------------------------
#
# Leave CLOUD_API_KEY unset to run Ollama-only, which is this environment's
# default. Setting it makes the cloud provider the PRIMARY, with Ollama as the
# fallback link behind it (spec §10.3); a successful fallback is recorded as
# degraded_reason=cloud_fallback_to_ollama, not as a clean answer.
#
# CLOUD_PROVIDER picks the wire protocol, and CLOUD_MODEL must be a name that
# provider recognises — the two are not cross-checked, so switching provider
# without switching model reaches the API and fails there.
#
#   openai     any OpenAI-compatible gateway. REQUIRES CLOUD_BASE_URL — there
#              is no default endpoint to fall back on.
#   anthropic  first-party Claude. CLOUD_BASE_URL optional (proxy override).
#              NOTE: no JSON output mode exists on this API, so only the
#              system prompt keeps the reply parseable — watch the eval gate
#              when switching to it (ADR-0007).
#   gemini     first-party Gemini. CLOUD_BASE_URL is REJECTED: the Google
#              client has no endpoint override, so accepting one would mean
#              silently ignoring it.
#
# Every misconfiguration here fails the boot rather than quietly running
# Ollama-only, which is how a "cloud primary" used to be invisible when only
# half of it was set.
CLOUD_PROVIDER=openai
# CLOUD_API_KEY=
# CLOUD_BASE_URL=
CLOUD_MODEL=claude-sonnet-5

# Ceiling on a single cloud generation. A triage proposal is a small JSON
# object, so this sits well clear of a legitimate reply — it is here to stop a
# runaway generation from eating the per-ticket latency budget. Anthropic
# defaults to 128000 if this is left unset.
CLOUD_MAX_OUTPUT_TOKENS=4096

# Note: unlike Ollama and the openai-compatible link, the anthropic and gemini
# clients take a single flat timeout — they cannot express the 3s-connect /
# long-read split above, because their timeout fields are plain floats with no
# injectable HTTP client. See ADR-0007 for why that is accepted rather than
# worked around.

# "ollama" for real embeddings (requires `ollama pull bge-m3`), or "stub"
# for the deterministic offline embedder used in CI / no-GPU environments.
EMBEDDING_PROVIDER=ollama
# "lexical" (default) scores |query ∩ passage| / |query| — deterministic, fast,
# no model. "cross_encoder" (bge-reranker-v2-m3) is what spec §6.3 assumes for
# retrieval quality, and it is ALWAYS AVAILABLE: the dependency and the weights
# ship inside the ai-engine image, which runs HF_HUB_OFFLINE=1. Switching is
# this one variable plus a restart — no rebuild, no download.
#
# ⚠️ They are separate calibrations. retrieval.floor = 0.45 is a CROSS-ENCODER
# score (ADR-0005), so under the default it is compared against a token-overlap
# ratio — a different question, answered silently. Refusal behaviour under
# `lexical` is uncalibrated; see docs/TODO.md item 4.
RERANKER_PROVIDER=lexical

# Which checkpoint gets baked into the image and loaded at runtime — the build
# arg and the env var must agree, because the container runs HF_HUB_OFFLINE=1
# and a mismatch is a hard error on the first score(). Pin RERANKER_REVISION to
# a commit sha rather than leaving it at "main": a new upstream commit silently
# changes the score distribution the floor was fitted against.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=main

NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── Advanced ─────────────────────────────────────────────────────────────
# These have working defaults in docker-compose.yml and rarely need setting
# by hand; they are listed so the full configuration surface is discoverable.
#
# ALLOWED_HOSTS=*                              # Django allowed hosts (compose sets "*")
# CORS_ALLOWED_ORIGINS=http://localhost:3000   # where the web frontend is served from
# AI_ENGINE_URL=http://ai-engine:8001          # core-api -> ai-engine
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# THRESHOLDS_PATH=/workspace/services/core-api/config/thresholds.yaml
# LOG_LEVEL=INFO
