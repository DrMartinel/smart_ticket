# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# uv
uv.lock.bak

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Eval run artifacts (generated, not authored)
evals/.results.json
evals/report.md

# Env files with real secrets. The glob covers .env.bak / .env.save and
# any other local copy — those carry the same keys as the original.
infra/.env
infra/.env.*
!infra/.env.example
.env
.env.*
!.env.example
.env.local

# Claude Code session artifact — churns every run, not project state.
.claude/scheduled_tasks.lock

# Editors / OS
.vscode/
.idea/
.DS_Store

# Docker volumes are named, not bind-mounted, so nothing to ignore there.
