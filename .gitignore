# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# uv
uv.lock.bak

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Eval run artifacts (generated, not authored)
evals/.results.json
evals/report.md

# Env files with real secrets, in any directory. The glob covers .env.bak /
# .env.save and any other local copy — those carry the same keys as the
# original. Only the root .env.example is shared config.
.env
.env.*
!.env.example
.env.local

# Claude Code session artifact — churns every run, not project state.
.claude/scheduled_tasks.lock

# Editors / OS
.vscode/
.idea/
.DS_Store

# Hugging Face model cache bind-mounted into the vLLM containers
# (HF_CACHE_DIR, default infra/.hf-cache) — ~10 GB of downloaded weights.
infra/.hf-cache/

# Per-machine compose tuning (e.g. GPU flags), merged automatically by
# `docker compose` — not shared config.
docker-compose.override.yml

# Fetched AWS documentation (large, re-fetchable by demo_kb/fetch.py).
# The script, sources.json and manifest.json are tracked; manifest.json
# pins the exact snapshot.
demo_kb/guides/
