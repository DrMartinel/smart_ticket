# Smart Ticket Triage configuration template: every setting, its shipped
# value, and why.
#
#     cp .env.example .env
#
# Nothing reads this file. core-api, ai-engine and docker-compose read .env
# (git-ignored) and real environment variables, which win; neither the
# settings code nor docker-compose.yml holds a default. A setting missing from
# .env fails the boot. After pulling, diff your .env against this file: a
# changed value here (a prompt version, a model pin) does not reach an
# existing .env on its own.
#
# Values are for processes on the host: runserver, uvicorn, pytest, CI. For the
# Docker stack, docker-compose.yml passes each service its settings from .env
# and sets the container-side wiring itself (db:5432, redis:6379,
# ai-engine:8001, vllm-*:8000). An empty value counts as unset.
#
# Calibration numbers are not here: they live in
# services/core-api/config/thresholds.yaml (hard rule 2), which core-api
# snapshots into every routing decision.

# ═══ Docker stack (read by docker-compose.yml) ════════════════════════════════

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=smart_triage
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_password
# The ai_engine_ro role's password: set by migrations (core-api), used in
# AI_ENGINE_DATABASE_URL below and in compose's container DSN.
POSTGRES_AI_RO_PASSWORD=ai_engine_ro_password

# --- Self-hosted vLLM (ADR-0009), `docker compose --profile vllm up -d` --------
# vLLM reserves GPU memory up front, per server; the three fractions share one
# card. Tune to your VRAM (docs/onboarding.md step 2). On a 12 GiB card, 0.1 is
# too little for the embedder or reranker: their weights alone take ~1.1 GiB.
VLLM_IMAGE_TAG=latest
VLLM_CHAT_GPU_UTIL=0.6
VLLM_CHAT_MAX_MODEL_LEN=8192
VLLM_EMBED_GPU_UTIL=0.12
VLLM_RERANK_GPU_UTIL=0.12
# Hugging Face cache bind-mounted into the vLLM containers: ~10 GB of weights.
HF_CACHE_DIR=./infra/.hf-cache
# The checkpoint vllm-rerank loads. Pin it to a commit sha rather than "main":
# a new upstream commit silently moves the score scale the retrieval floor is
# compared against (ADR-0005).
RERANKER_REVISION=main

# --- Web ----------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ═══ Both services ════════════════════════════════════════════════════════════

# Ceiling for one model call, seconds. ai-engine uses it for its vLLM calls;
# core-api uses it as the read timeout on the embed and PII NER calls it makes
# to ai-engine. Generous by design: a cold model load alone can take 15-20s,
# and the old 3s NER budget meant essentially every ticket timed out into
# MASK_FAILED before the model had finished loading. MASK_FAILED is right when
# we genuinely can't verify (spec §5.2), but it should mean "the model is
# down", not "still warming up". If you raise this past 120, also raise
# budget.max_latency_sec in thresholds.yaml and the gunicorn --timeout in
# services/core-api/docker-entrypoint.sh, or one of those cuts the call short.
MODEL_TIMEOUT_SEC=120
# Connect budget for every call to a model server (ai-engine) or to ai-engine
# (core-api), kept SHORT and separate from the read budget above. Can't open a
# TCP connection means unreachable (down, wrong host, firewall dropping the
# Docker subnet), and waiting longer cannot help. Connected but slow means a
# model is loading or generating, which needs the full read budget. Collapsing
# the two made a blocked route hang the submit form for two minutes instead
# of erroring in three: masking runs inline in the submit request.
MODEL_CONNECT_TIMEOUT_SEC=3

# Model names. The vllm-* servers load these and ai-engine asks for them by
# name, so each must be one variable for both.
CHAT_MODEL=Qwen/Qwen3-8B-AWQ
EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ═══ core-api ═════════════════════════════════════════════════════════════════

# --- Django -------------------------------------------------------------------
# Dev-only and public. production.py refuses to start with this value or the
# PII key below: set real ones in .env for anything beyond local dev.
SECRET_KEY=dev-only-insecure-secret-key-change-me
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Where the web frontend is served from.
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Database and broker (host ports of the Dockerized services) ---------------
DATABASE_URL=postgresql://app_user:app_password@localhost:5434/smart_triage
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# --- Smart Triage -------------------------------------------------------------
# Spec §14 P1: the router decides and records, humans still handle every ticket.
SHADOW_MODE=true
# core-api's only route to a model. ai-engine is the only vLLM client
# (ADR-0012), so core-api has no model URL, model name or embedding provider.
AI_ENGINE_URL=http://localhost:8001
# Slack on top of thresholds.yaml's budget.max_latency_sec for the /v1/analyze
# read timeout, so a run that finishes right at the budget still delivers.
AI_ENGINE_ANALYZE_GRACE_SEC=5

# AES-GCM key for pii_quarantine.ciphertext: 32 raw bytes, base64-encoded.
# Dev-only and public. Generate one with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=Zm9yLWRldi1vbmx5LTMyLWJ5dGUta2V5LWhlcmUhISE=
# Hard TTL on encrypted raw PII; the hourly beat task deletes past this.
PII_QUARANTINE_TTL_HOURS=72

# --- Files (relative paths resolve against the repo root) ----------------------
THRESHOLDS_PATH=services/core-api/config/thresholds.yaml
# The demo KB snapshot, read by `manage.py load_demo_kb`.
DEMO_KB_DIR=demo_kb

# ═══ ai-engine ════════════════════════════════════════════════════════════════
# ai-engine never reads thresholds.yaml: core-api owns calibration, and the
# retrieval floors arrive per request in AIRunRequest.

# --- Database -----------------------------------------------------------------
# The read-only role: SELECT on kb_articles, kb_chunks and fewshot_examples
# only (ADR-0004). Its own name, not DATABASE_URL: that one is core-api's
# read-write role, and the boundary is the point.
AI_ENGINE_DATABASE_URL=postgresql://ai_engine_ro:ai_engine_ro_password@localhost:5434/smart_triage
# Connections kept open and reused across tickets; each node borrows one only
# for its reads, never across a model call. A ticket holds at most one at a
# time, so this is roughly the number of tickets reading the KB at once.
AI_ENGINE_DB_POOL_SIZE=5
# Extra connections opened under a burst and closed when returned. Pool size
# plus this is ai-engine's ceiling on Postgres connections (max_connections
# is 100 by default, shared with core-api and Celery).
AI_ENGINE_DB_MAX_OVERFLOW=10

# --- Models -------------------------------------------------------------------
# Where triage chat runs: "vllm" (CHAT_MODEL on CHAT_BASE_URL) or "openai" (the
# CLOUD_* settings below). Embeddings, rerank and PII NER always run on vLLM.
CHAT_CLIENT_PROVIDER=vllm
# The vLLM servers' host ports. The containers use the compose services
# (http://vllm-chat:8000/v1, ...), set in docker-compose.yml.
CHAT_BASE_URL=http://localhost:8100/v1
EMBED_BASE_URL=http://localhost:8101/v1
RERANK_BASE_URL=http://localhost:8102/v1

# "vllm" | "stub". "stub" is deterministic and offline, for CI.
# ⚠️ The KB vectors in pgvector must come from the same model on the same
# runtime: re-embed the KB through vLLM, or retrieval degrades silently.
EMBEDDING_PROVIDER=vllm
# The shortlister, which orders the pool so its top RERANK_POOL chunks go to the
# reranker (Jev): "vllm" serves the RERANKER_MODEL cross-encoder from
# vllm-rerank (bge-reranker is a reranker model, used here to shortlist); "lexical" is
# deterministic, offline and dependency-free, for CI. Never compared with a
# threshold: the floor is on Jev's scale (ADR-0005, ADR-0015).
SHORTLIST_PROVIDER=vllm

# --- OpenAI (CHAT_CLIENT_PROVIDER=openai) ---------------------------------------
# Key and model are required then; CLOUD_BASE_URL is an optional proxy.
# Validated in providers/llm/models.py: any misconfiguration is fatal at boot.
# A failing call degrades the ticket to HITL; there is no fallback provider.
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=
# Ceiling on a single cloud generation. A triage proposal is a small JSON
# object, so this is well clear of a legitimate reply. It is here to stop a
# runaway generation from running until the read timeout.
CLOUD_MAX_OUTPUT_TOKENS=4096

# --- Versions (eval-gated like code) ------------------------------------------
GRAPH_VERSION=v2.1
PROMPT_VERSION=classify.v5
# Tier-2 PII NER, on CHAT_MODEL through the self-hosted `ner` client (ADR-0012).
PII_NER_PROMPT_VERSION=pii_ner.v2

# --- Retrieval ----------------------------------------------------------------
RRF_K=60
BM25_TOP_K=20
# Added to a BM25 hit's score when the chunk contains an error code from the
# ticket (`ERR-4042`, `0x1A2B3C4D`). It only reorders BM25's own list; the
# fused and reranked order never sees the score (ADR-0005, ADR-0013).
BM25_ERROR_CODE_BOOST=0.5
VECTOR_TOP_K=20
RERANK_TOP_N=3
FEWSHOT_K=3
# How many post-fusion candidates the shortlister actually scores: its batch size,
# so directly a cost/latency knob. A SLICE of an RRF-ordered list, never a
# threshold on the RRF score (ADR-0005).
FUSION_CANDIDATE_LIMIT=10

# The validator's narrow allowance for whitespace/punctuation drift in a
# verbatim quote. NOT a general "close enough" check (spec §6.4).
QUOTE_FUZZY_THRESHOLD=0.95

# --- Link expansion (ADR-0014 decisions 1-2, ADR-0015), always on ---------------
# Adds pages linked from the articles of the cross-encoder's top
# LINK_EXPANSION_SEEDS chunks to the pool the cross-encoder scores.
# Seed chunks whose articles' links are followed. Seeding from all ten
# candidates doubled the pool and recovered nothing more (ADR-0014).
LINK_EXPANSION_SEEDS=3
# Chunks taken from each linked page, nearest the query embedding.
LINK_EXPANSION_CHUNKS_PER_PAGE=5
# Links followed per seed article, in document order. One page links to 198
# others; 95% link to 12 or fewer. 20 kept every probe result and cut the
# largest pool from 206 to 174 chunks (evals/HISTORY.md 2026-10-02 (4)). A cost
# limit, not a threshold.
LINK_EXPANSION_MAX_LINKS_PER_SEED=20

# --- Jev, the reranker (ADR-0015), always on ------------------------------------
# Jev's score is the final one: retrieval.floor is set on its scale and the
# trust signals carry it. Every ticket's MASKED text is sent to Jev's hosted
# API; raw text never is.
# The shortlist: the top N chunks of the shortlister's order that Jev scores. A
# slice of that order, so a cost/latency limit, never a threshold (ADR-0005):
# one Jev request per chunk.
RERANK_POOL=15
JEV_BASE_URL=https://api.typesafe.ai/v1
# Pinned, never the `jev-latest` alias: an alias move would silently change the
# score scale the Jev floor is set against.
JEV_MODEL=jev-1.13.0
# Required for any run that reaches Jev; tests and offline CI use a fake.
JEV_API_KEY=
# The Noul question Jev answers per chunk, core/prompts/<version>.json.
# Eval-gated like the classify prompt.
RERANK_PROMPT_VERSION=rerank_resolves.v1
